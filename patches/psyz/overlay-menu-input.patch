+static void PollEvents(void) {
+    PollEventsOnce();
+#ifdef LOM_NATIVE_MENU
+
+    if (!lom_native_menu_paused() || Psyz_QuitRequested()) {
+        if (!Sdl3Common_IsInBackground() && !Psyz_QuitRequested()) {
+            lom_native_menu_pause_movie(false);
+        }
+
+        return;
+    }
+
+    SDL_SetAtomicInt(&menu_resume_audio, 0);
+    SDL_SetAtomicInt(&menu_pause_active, 1);
+
+    if (!Psyz_AudioIsPaused() || SDL_GetAtomicInt(&resume_audio_on_foreground)) {
+        SDL_SetAtomicInt(&menu_resume_audio, 1);
+    }
+
+    Cadence_SetPause(1, 1);
+    Psyz_AudioPause();
+    lom_native_menu_pause_movie(true);
+
+    while (lom_native_menu_paused() && !Psyz_QuitRequested()) {
+        PlatformBackend_Present();
+        SDL_Delay(menu_poll_interval_ms);
+        PollEventsOnce();
+    }
+
+    Cadence_SetPause(0, 1);
+    SDL_SetAtomicInt(&menu_pause_active, 0);
+
+    if (SDL_SetAtomicInt(&menu_resume_audio, 0) && !Psyz_QuitRequested()) {
+        if (Sdl3Common_IsInBackground()) {
+            SDL_SetAtomicInt(&resume_audio_on_foreground, 1);
+
+            if (!Sdl3Common_IsInBackground() && SDL_SetAtomicInt(&resume_audio_on_foreground, 0)) {
+                Psyz_AudioUnpause();
+            }
+        } else {
+            Psyz_AudioUnpause();
+        }
+    }
+
+    if (!Sdl3Common_IsInBackground() && !Psyz_QuitRequested()) {
+        lom_native_menu_pause_movie(false);
+    }
+
+    SDL_SetAtomicInt(&timing_reset_requested, 1);
+    Sdl3Common_ApplyPendingTimingReset();
+#endif
+}
