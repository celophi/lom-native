Draw the in-game menu over the game frame, and pass shortcut keys to the menu
before PSY-Z's own.
--- a/psyz/src/platform/sdl3_gpu.c
+++ b/psyz/src/platform/sdl3_gpu.c
@@ -12,8 +12,39 @@
 #include "sdl3_common.h"
