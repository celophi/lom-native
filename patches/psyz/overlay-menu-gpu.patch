 #include "rgb24.h"
+#include "lom_native_display.h"
 
 static LomPresentation presentation;
+
+static void PlatformBackend_HandleHostEvent(const SDL_Event* event) {
+    if (!lom_native_menu_blocks_input()) {
+        lom_present_event(&presentation, event);
+    }
+}
+
+int lom_native_display_filter(void) {
+    return presentation.mode;
+}
+int lom_native_display_resolution(void) {
+    return presentation.resolution;
+}
+bool lom_native_display_fullscreen(void) {
+    return is_fullscreen;
+}
+bool lom_native_display_pending(void) {
+    return lom_present_resolution_pending(&presentation);
+}
+const char* lom_native_display_error(void) {
+    return presentation.resolution_error;
+}
+void lom_native_display_set(int filter, int resolution, bool fullscreen) {
+    if (filter >= 0 && filter < LOM_PRESENT_COUNT) {
+        presentation.mode = filter;
+    }
+
+    lom_present_request_resolution(&presentation, resolution);
+    SetFullScreen(fullscreen);
+}
 static bool display_rgb24;
 
