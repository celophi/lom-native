+static bool WidescreenView(const VideoLayout* l, SDL_Rect* view, float* aspect) {
+    const int margin = lom_native_widescreen_margin();
+    const int w = l->fb.w + 2 * margin;
+    const int x = -l->screen.sx - margin;
+    if (!margin || x < 0 || x + w > l->canvas.w || l->fb.w <= 0 ||
+        l->canvas.h <= 0) {
+        return false;
+    }
+    *view = (SDL_Rect){x, 0, w, l->canvas.h};
+    *aspect = GetCurrentGameAspectRatio(l->fb.w, l->fb.h) * (float)w /
+              (float)l->fb.w * (float)l->fb.h / (float)l->canvas.h;
+    return true;
+}
