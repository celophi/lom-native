+
+static short spu_noise_tick(unsigned short spucnt) {
+    int step = 4 + ((spucnt >> 8) & 3);
+    int shift = (spucnt >> 10) & 0xF;
+    int parity;
+
+    spu.noise_timer -= step;
+    if (spu.noise_timer < 0) {
+        parity = ((spu.noise_level >> 15) ^ (spu.noise_level >> 12) ^
+                  (spu.noise_level >> 11) ^ (spu.noise_level >> 10) ^ 1) & 1;
+        spu.noise_level = (u16)((spu.noise_level << 1) | parity);
+        spu.noise_timer += 0x20000 >> shift;
+        if (spu.noise_timer < 0)
+            spu.noise_timer += 0x20000 >> shift;
+    }
+    return (short)spu.noise_level;
 }

