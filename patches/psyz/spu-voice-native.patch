Set a voice's ENDX bit when it ends and mark it keyed off, which AKAO reads.

--- a/psyz/src/psyz/spu_voice.h
+++ b/psyz/src/psyz/spu_voice.h
@@ -3,8 +3,8 @@
 
 #include <psyz.h>
 #include <psyz/log.h>
-#include "../../decomp/src/libspu/libspu_private.h"
-#include "spu_gauss.h"
+#include <libspu_private.h>
+#include <spu_gauss.h>
 
 // One ADPCM block decodes to 28 samples
 #define ADPCM_BLOCK_BYTES 16
@@ -98,10 +98,10 @@
     u16 adsr_hi;          // mirrors SPU_VOICE_REG::adsr[1]
 } VoiceState;
 
-static inline void spu_voice_decode_one_sample(VoiceState* vs, const u8* ram);
