+void lom_native_spu_set_category_volumes(int music, int sfx) {
+    if (music < 0 || music > CATEGORY_GAIN_MAXIMUM || sfx < 0 || sfx > CATEGORY_GAIN_MAXIMUM) {
+        return;
+    }
