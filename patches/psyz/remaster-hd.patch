+void lom_hd_textures_draw(
+    const int xy[8], int layer, int cell, unsigned int rgb, int semi,
+    int tpage) {
+    static const unsigned short corner_u[4] = {0, HD_CELL, 0, HD_CELL};
+    static const unsigned short corner_v[4] = {0, 0, HD_CELL, HD_CELL};
+    if (!hd_texture || layer < 0 || layer >= hd_layers) {
+        return;
+    }
+    Draw_EnsureBufferWillNotOverflow(4, 6);
+    Vertex* v = vertex_cur;
+    for (int i = 0; i < 4; i++) {
+        v[i].x = (short)s11(xy[i * 2]);
+        v[i].y = (short)s11(xy[i * 2 + 1]);
+        v[i].u = corner_u[i];
+        v[i].v = corner_v[i];
+    }
+    v[0].r = (unsigned char)(rgb >> 0);
+    v[0].g = (unsigned char)(rgb >> 8);
+    v[0].b = (unsigned char)(rgb >> 16);
+    v[0].a = semi ? 0x80 : 0xFF;
+    VRGBA(v[1]) = VRGBA(v[2]) = VRGBA(v[3]) = VRGBA(v[0]);
+    index_cur[0] = n_vertices + 0;
+    index_cur[1] = n_vertices + 1;
+    index_cur[2] = n_vertices + 2;
+    index_cur[3] = n_vertices + 1;
+    index_cur[4] = n_vertices + 3;
+    index_cur[5] = n_vertices + 2;
+    SET_TC_ALL(
+        v, ((tpage < 0 ? cur_tpage : tpage) & 0x1FF) | TPAGE_HD,
+        (layer << 8) | (cell & 0xFF));
+    Draw_EnqueueBuffer(4, 6);
+}
