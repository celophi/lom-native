+static bool CreateHdResources(void) {
+    const SDL_GPUSamplerCreateInfo info = {
+        .min_filter = SDL_GPU_FILTER_LINEAR,
+        .mag_filter = SDL_GPU_FILTER_LINEAR,
+        .mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_NEAREST,
+        .address_mode_u = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+        .address_mode_v = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+        .address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+    };
+    hd_sampler = SDL_CreateGPUSampler(device, &info);
+    const SDL_GPUTextureCreateInfo empty_info = {
+        .type = SDL_GPU_TEXTURETYPE_2D_ARRAY,
+        .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+        .usage = SDL_GPU_TEXTUREUSAGE_SAMPLER,
+        .width = 1,
+        .height = 1,
+        .layer_count_or_depth = 1,
+        .num_levels = 1,
+    };
+    hd_empty = SDL_CreateGPUTexture(device, &empty_info);
+    const SDL_GPUSamplerCreateInfo image_info = {
+        .min_filter = SDL_GPU_FILTER_LINEAR,
+        .mag_filter = SDL_GPU_FILTER_LINEAR,
+        .mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_LINEAR,
+        .address_mode_u = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+        .address_mode_v = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+        .address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+        .max_lod = IMAGE_LEVELS - 1,
+    };
+    image_sampler = SDL_CreateGPUSampler(device, &image_info);
+    if (!hd_sampler || !hd_empty || !image_sampler) {
+        ERRORF("HD page resources: %s", SDL_GetError());
+        return false;
+    }
+    return true;
+}
+
+void lom_hd_texture_release(int which) {
+    Draw_FlushBuffer();
+    if (hd_textures[which]) {
+        SDL_ReleaseGPUTexture(device, hd_textures[which]);
+        hd_textures[which] = NULL;
+    }
+}
+
+int lom_hd_texture_create(int which, int layers, int size, int levels) {
+    lom_hd_texture_release(which);
+    const SDL_GPUTextureCreateInfo info = {
+        .type = SDL_GPU_TEXTURETYPE_2D_ARRAY,
+        .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+        .usage = SDL_GPU_TEXTUREUSAGE_SAMPLER |
+                 (levels > 1 ? SDL_GPU_TEXTUREUSAGE_COLOR_TARGET : 0),
+        .width = (Uint32)size,
+        .height = (Uint32)size,
+        .layer_count_or_depth = (Uint32)layers,
+        .num_levels = (Uint32)levels,
+    };
+    hd_textures[which] = device ? SDL_CreateGPUTexture(device, &info) : NULL;
+    if (!hd_textures[which]) {
+        ERRORF("HD texture %d (%d of %dx%d): %s", which, layers, size, size,
+               SDL_GetError());
+        return -1;
+    }
+    return 0;
+}
+
+int lom_hd_texture_upload(
+    int which, int layer, int x, int y, int w, int h, const void* pixels) {
+    Draw_FlushBuffer();
+    const Uint32 bytes = (Uint32)w * (Uint32)h * 4;
+    const SDL_GPUTransferBufferCreateInfo transfer_info = {
+        .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD, .size = bytes};
+    SDL_GPUTransferBuffer* transfer =
+        SDL_CreateGPUTransferBuffer(device, &transfer_info);
+    if (!transfer) {
+        return -1;
+    }
+    void* map = SDL_MapGPUTransferBuffer(device, transfer, false);
+    if (!map) {
+        SDL_ReleaseGPUTransferBuffer(device, transfer);
+        return -1;
+    }
+    memcpy(map, pixels, bytes);
+    SDL_UnmapGPUTransferBuffer(device, transfer);
+    SDL_GPUCommandBuffer* cmd = AcquireCmd();
+    if (!cmd) {
+        SDL_ReleaseGPUTransferBuffer(device, transfer);
+        return -1;
+    }
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    const SDL_GPUTextureTransferInfo src = {
+        .transfer_buffer = transfer,
+        .pixels_per_row = (Uint32)w,
+        .rows_per_layer = (Uint32)h};
+    const SDL_GPUTextureRegion dst = {
+        .texture = hd_textures[which],
+        .layer = (Uint32)layer,
+        .x = (Uint32)x,
+        .y = (Uint32)y,
+        .w = (Uint32)w,
+        .h = (Uint32)h,
+        .d = 1};
+    SDL_UploadToGPUTexture(copy, &src, &dst, false);
+    SDL_EndGPUCopyPass(copy);
+    SDL_ReleaseGPUTransferBuffer(device, transfer);
+    return 0;
+}
+
+void lom_hd_texture_mipmaps(int which) {
+    SDL_GPUCommandBuffer* cmd = AcquireCmd();
+    if (cmd) {
+        SDL_GenerateMipmapsForGPUTexture(cmd, hd_textures[which]);
+    }
+}
+
+void lom_hd_quad(const short xy[8], const unsigned short uv[8], unsigned rgba,
+                 int tpage, unsigned flags, unsigned clut) {
+    Draw_EnsureBufferWillNotOverflow(4, 6);
+    Vertex* v = vertex_cur;
+    for (int i = 0; i < 4; i++) {
+        v[i].x = xy[i * 2];
+        v[i].y = xy[i * 2 + 1];
+        v[i].u = uv[i * 2];
+        v[i].v = uv[i * 2 + 1];
+    }
+    v[0].r = (unsigned char)(rgba >> 24);
+    v[0].g = (unsigned char)(rgba >> 16);
+    v[0].b = (unsigned char)(rgba >> 8);
+    v[0].a = (unsigned char)rgba;
+    VRGBA(v[1]) = VRGBA(v[2]) = VRGBA(v[3]) = VRGBA(v[0]);
+    index_cur[0] = n_vertices + 0;
+    index_cur[1] = n_vertices + 1;
+    index_cur[2] = n_vertices + 2;
+    index_cur[3] = n_vertices + 1;
+    index_cur[4] = n_vertices + 3;
+    index_cur[5] = n_vertices + 2;
+    SET_TC_ALL(v, ((tpage < 0 ? cur_tpage : tpage) & 0x1FF) | flags, clut);
+    Draw_EnqueueBuffer(4, 6);
+}
