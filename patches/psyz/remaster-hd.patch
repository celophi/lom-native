+void lom_hd_textures_release(void) {
+    Draw_FlushBuffer();
+    if (hd_texture) {
+        SDL_ReleaseGPUTexture(device, hd_texture);
+        hd_texture = NULL;
+    }
+    hd_layers = 0;
+    hd_size = 0;
+}
+
+int lom_hd_textures_set(int layers, int size) {
+    lom_hd_textures_release();
+    if (!device || layers <= 0 || size <= 0) {
+        return -1;
+    }
+    hd_texture = CreateHdTexture(size, layers);
+    if (!hd_texture) {
+        ERRORF("HD pages (%d of %dx%d): %s", layers, size, size,
+               SDL_GetError());
+        return -1;
+    }
+    hd_layers = layers;
+    hd_size = size;
+    return 0;
+}
+
+int lom_hd_textures_upload(int layer, const void* rgba) {
+    if (!hd_texture || layer < 0 || layer >= hd_layers || !rgba) {
+        return -1;
+    }
+    const Uint32 bytes = (Uint32)hd_size * (Uint32)hd_size * 4;
+    const SDL_GPUTransferBufferCreateInfo transfer_info = {
+        .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD, .size = bytes};
+    SDL_GPUTransferBuffer* transfer =
+        SDL_CreateGPUTransferBuffer(device, &transfer_info);
+    if (!transfer) {
+        return -1;
+    }
+    void* map = SDL_MapGPUTransferBuffer(device, transfer, false);
+    if (!map) {
+        SDL_ReleaseGPUTransferBuffer(device, transfer);
+        return -1;
+    }
+    memcpy(map, rgba, bytes);
+    SDL_UnmapGPUTransferBuffer(device, transfer);
+    SDL_GPUCommandBuffer* cmd = AcquireCmd();
+    if (!cmd) {
+        SDL_ReleaseGPUTransferBuffer(device, transfer);
+        return -1;
+    }
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    const SDL_GPUTextureTransferInfo src = {
+        .transfer_buffer = transfer,
+        .pixels_per_row = (Uint32)hd_size,
+        .rows_per_layer = (Uint32)hd_size};
+    const SDL_GPUTextureRegion dst = {
+        .texture = hd_texture,
+        .layer = (Uint32)layer,
+        .w = (Uint32)hd_size,
+        .h = (Uint32)hd_size,
+        .d = 1};
+    SDL_UploadToGPUTexture(copy, &src, &dst, false);
+    SDL_EndGPUCopyPass(copy);
+    SDL_ReleaseGPUTransferBuffer(device, transfer);
+    return 0;
+}
