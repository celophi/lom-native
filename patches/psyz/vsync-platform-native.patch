+static uint64_t Cadence_ActiveTime(void)
+{
+    uint64_t now;
+    SDL_LockSpinlock(&cadence_lifecycle_lock);
+    if (lvc_active_time(&cadence_lifecycle, SDL_GetTicksNS(), &now)) {
+        SDL_SetAtomicInt(&cadence_failed, 1); now = 0;
+    }
+    SDL_UnlockSpinlock(&cadence_lifecycle_lock);
+    return now;
+}
+static void Cadence_Background(int background)
+{
+    SDL_LockSpinlock(&cadence_lifecycle_lock);
+    int failed = background ? lvc_background(&cadence_lifecycle, SDL_GetTicksNS())
+                            : lvc_foreground(&cadence_lifecycle, SDL_GetTicksNS());
+    if (failed) SDL_SetAtomicInt(&cadence_failed, 1);
+    SDL_UnlockSpinlock(&cadence_lifecycle_lock);
+}
+static void Cadence_Configure(double fps, uint32_t lines)
+{
+    uint32_t num, den;
+    if (fabs(fps - 59.94) < 0.001) { num = 60000; den = 1001; }
+    else if (fabs(fps - 50.0) < 0.001) { num = 50; den = 1; }
+    else { num = (uint32_t)llround(fps * 1000000.0); den = 1000000; }
+    if (!cadence_clock.initialized) {
+        if (lvc_init(&cadence_clock, Cadence_ActiveTime(), num, den,
+                     Psyz_AudioIsVirtualClock())) SDL_SetAtomicInt(&cadence_failed, 1);
+        else cadence_clock.lines = lines;
+    } else if (lvc_observe(&cadence_clock, Cadence_ActiveTime()) ||
+               lvc_display(&cadence_clock, num, den, lines)) {
+        SDL_SetAtomicInt(&cadence_failed, 1);
+    }
+}
+
+static void Cadence_Rate(double fps)
+{
+    Cadence_Configure(fps, cadence_clock.initialized ? cadence_clock.lines : 263);
+}
+static void Cadence_DisplayMode(int pal, int interlaced)
+{
+    if (interlaced) { SDL_SetAtomicInt(&cadence_failed, 1); return; }
+    Cadence_Configure(pal ? 50.0 : 59.94, pal ? 314 : 263);
+}
