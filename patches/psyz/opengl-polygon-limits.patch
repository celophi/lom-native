+static bool TriangleWithinSizeLimit(const Vertex* a, const Vertex* b, const Vertex* c) {
+    int min_x = a->x, max_x = a->x, min_y = a->y, max_y = a->y;
+    const Vertex* rest[2] = {b, c};
+    for (int i = 0; i < 2; ++i) {
+        if (rest[i]->x < min_x) min_x = rest[i]->x;
+        if (rest[i]->x > max_x) max_x = rest[i]->x;
+        if (rest[i]->y < min_y) min_y = rest[i]->y;
+        if (rest[i]->y > max_y) max_y = rest[i]->y;
+    }
+    return max_x - min_x <= 1023 && max_y - min_y <= 511;
+}
