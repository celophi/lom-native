@@ -723,2 +619,139 @@

 int CheckCallback(void) { return OwnsKernel() && in_interrupt; }
+
+static struct {
+    atomic_uint count;
+    unsigned period;
+    unsigned ticks_per_sample;
+    unsigned configured;
+    unsigned irq_enabled;
+    unsigned irq_mode;
+    unsigned irq_pending;
+    unsigned delivering;
+    void (*handler)(void);
+} rcnt2;
+
+static struct {
+    unsigned rate_hz;
+    unsigned accum;
+    void (*handler)(void);
+} rcnt3;
+
+static unsigned set_counter = 0;
+
+void* InterruptCallback(int arg0, void (*cb)()) {
+    if (arg0 < 0 || arg0 >= 0x100) {
+        return NULL;
+    }
+    void (*prev)(void) = NULL;
+    switch (set_counter) {
+    case 2:
+        prev = rcnt2.handler;
+        rcnt2.handler = cb;
+        set_counter = 0;
+        break;
+    case 3:
+        prev = rcnt3.handler;
+        if (cb) {
+            rcnt3.handler = cb;
+            set_counter = 0;
+        }
+        break;
+    }
+    return prev;
+}
+
+static unsigned rcnt_counter(long spec) {
+    return (unsigned)(spec & 0xFFFF);
+}
+
+long SetRCnt(long spec, unsigned short target, long mode) {
+    unsigned counter = rcnt_counter(spec);
+    switch (counter) {
+    case 2:
+        rcnt2.period = target ? target : 65536u;
+        rcnt2.ticks_per_sample = (mode & 1) ? 768u : 96u;
+        rcnt2.configured = 1;
+        rcnt2.irq_mode = (mode & 0x1000) != 0;
+        atomic_store_explicit(&rcnt2.count, 0, memory_order_relaxed);
+        break;
+    case 3:
+        rcnt3.rate_hz = (GetVideoMode() == MODE_PAL) ? 50 : 60;
+        rcnt3.accum = 0;
+        break;
+    default:
+        return 0;
+    }
+    set_counter = counter;
+    return 1;
+}
+
+long GetRCnt(long spec) {
+    if (rcnt_counter(spec) != 2) return 0;
+    return atomic_load_explicit(&rcnt2.count, memory_order_relaxed);
+}
+
+long StartRCnt(long spec) {
+    if (rcnt_counter(spec) != 2) return 0;
+    rcnt2.irq_enabled = 1;
+    return 1;
+}
+
+long StopRCnt(long spec) {
+    if (rcnt_counter(spec) != 2) return 0;
+    rcnt2.irq_enabled = 0;
+    set_counter = 2;
+    return 1;
+}
+
+long ResetRCnt(long spec) {
+    switch (rcnt_counter(spec)) {
+    case 2:
+        atomic_store_explicit(&rcnt2.count, 0, memory_order_relaxed);
+        break;
+    case 3:
+        rcnt3.accum = 0;
+        break;
+    default:
+        return 0;
+    }
+    return 1;
+}
+
+static void rcnt2_add_sample(void) {
+    if (!rcnt2.configured) return;
+    unsigned count = atomic_load_explicit(&rcnt2.count, memory_order_relaxed);
+    count += rcnt2.ticks_per_sample;
+    if (count >= rcnt2.period) {
+        count %= rcnt2.period;
+        if (rcnt2.irq_mode) rcnt2.irq_pending = 1;
+    }
+    atomic_store_explicit(&rcnt2.count, count, memory_order_relaxed);
+    if (rcnt2.irq_pending && rcnt2.irq_enabled && rcnt2.handler && !rcnt2.delivering) {
+        rcnt2.irq_pending = 0;
+        rcnt2.delivering = 1;
+        void (*callback)(void) = rcnt2.handler;
+        callback();
+        rcnt2.delivering = 0;
+    }
+}
+
+static void rcnt_add(int* accum_state, int rate_hz, int n, void (*cb)(void)) {
+    if (rate_hz <= 0 || !cb) {
+        return;
+    }
+    int accum = *accum_state + rate_hz * n;
+    while (accum >= PSYZ_SPU_SAMPLE_RATE) {
+        accum -= PSYZ_SPU_SAMPLE_RATE;
+        cb();
+    }
+    *accum_state = accum;
+}
+
+void Psyz_RcntAdd(int n) {
+    if (n <= 0) {
+        return;
+    }
+    for (int sample = 0; sample < n; ++sample) rcnt2_add_sample();
+    rcnt_add(&rcnt3.accum, rcnt3.rate_hz, n, rcnt3.handler);
+}
