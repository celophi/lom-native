function(lom_embed_file input output symbol)
    file(READ "${input}" bytes HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n" bytes "${bytes}")
    file(WRITE "${output}.tmp"
        "/* Generated by cmake/embed_file.cmake from ${input}. */\n"
        "#include <stddef.h>\n"
        "const unsigned char ${symbol}[] = {\n${bytes}\n};\n"
        "const size_t ${symbol}_size = sizeof(${symbol});\n")
    file(COPY_FILE "${output}.tmp" "${output}" ONLY_IF_DIFFERENT)
    file(REMOVE "${output}.tmp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
endfunction()
