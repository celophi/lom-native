set(LOM_NATIVE_CARD_FONTS "${CMAKE_CURRENT_BINARY_DIR}/generated/native_card_fonts.c")
set(font_source "#include <stdint.h>\n#include <stddef.h>\n")
foreach(index IN ITEMS 1 2)
    set(font "${LOM_PSYZ_DIR}/nugget/openbios/charset/font${index}.raw")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${font}")
    file(READ "${font}" bytes HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    string(APPEND font_source "const uint8_t _binary_charset_font${index}_raw_start[]={${bytes}};\nconst size_t lom_native_font${index}_bytes=sizeof(_binary_charset_font${index}_raw_start);\n")
endforeach()
file(CONFIGURE OUTPUT "${LOM_NATIVE_CARD_FONTS}" CONTENT "${font_source}" @ONLY)
add_library(lom_native_card_fonts OBJECT "${LOM_NATIVE_CARD_FONTS}" "${LOM_PSYZ_DIR}/nugget/openbios/charset/sjis.c")
target_include_directories(lom_native_card_fonts PRIVATE "${LOM_PSYZ_DIR}/nugget")
target_compile_options(lom_native_card_fonts PRIVATE "SHELL:-include ${CMAKE_CURRENT_SOURCE_DIR}/src/card/card_fonts.h")
target_compile_definitions(lom_native_card_fonts PRIVATE Krom2RawAdd=lom_native_openbios_krom)
