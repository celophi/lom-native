#include <winver.h>

IDI_ICON1 ICON "@lom_rc_icon@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @lom_rc_version@,0
PRODUCTVERSION @lom_rc_version@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@lom_rc_description@"
            VALUE "FileVersion", "@LOM_VERSION@"
            VALUE "InternalName", "@lom_rc_name@"
            VALUE "LegalCopyright", "lom-native, MIT license. Legend of Mana is (c) Square Enix."
            VALUE "OriginalFilename", "@lom_rc_file@"
            VALUE "ProductName", "Legend of Mana Native"
            VALUE "ProductVersion", "@LOM_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
