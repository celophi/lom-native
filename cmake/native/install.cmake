include(GNUInstallDirs)

if(UNIX AND NOT APPLE)
    set(lom_install_bin "${CMAKE_INSTALL_BINDIR}")
    set(lom_install_licenses "${CMAKE_INSTALL_DATADIR}/licenses/lom-native")
elseif(APPLE AND TARGET lom-launcher)
    set(lom_install_bin lom-launcher.app/Contents/MacOS)
    set(lom_install_licenses lom-launcher.app/Contents/Resources/licenses)
else()
    set(lom_install_bin .)
    set(lom_install_licenses licenses)
endif()

install(TARGETS lom lom-jp RUNTIME DESTINATION "${lom_install_bin}")

set(LOM_BUNDLED_FFMPEG "" CACHE PATH "Folder with the ffmpeg to install beside the game (packaging/ffmpeg/build.sh)")
if(LOM_BUNDLED_FFMPEG)
    install(PROGRAMS "${LOM_BUNDLED_FFMPEG}/ffmpeg${CMAKE_EXECUTABLE_SUFFIX}" DESTINATION "${lom_install_bin}")
    install(FILES "${LOM_BUNDLED_FFMPEG}/COPYING.LGPLv2.1" "${LOM_BUNDLED_FFMPEG}/FFMPEG-NOTICE.txt"
        DESTINATION "${lom_install_licenses}/ffmpeg")
endif()

set(psyz "${LOM_PSYZ_DIR}")
install(FILES LICENSE THIRD_PARTY_NOTICES.md DESTINATION "${lom_install_licenses}")
install(FILES game/LICENSE game/THIRD_PARTY_NOTICES.md DESTINATION "${lom_install_licenses}/game")
install(FILES patches/psyz/LICENSE DESTINATION "${lom_install_licenses}/psyz-patches")
install(FILES "${psyz}/psyz/src/platform/LICENSE" DESTINATION "${lom_install_licenses}/psyz")
install(FILES "${psyz}/decomp/LICENSE" DESTINATION "${lom_install_licenses}/psyz-decomp")
install(FILES "${psyz}/external/SDL/LICENSE.txt" DESTINATION "${lom_install_licenses}/sdl")
install(FILES "${psyz}/external/cimgui/LICENSE" DESTINATION "${lom_install_licenses}/cimgui")
install(FILES "${psyz}/external/cimgui/imgui/LICENSE.txt" DESTINATION "${lom_install_licenses}/imgui")
install(FILES "${psyz}/nugget/LICENSE" DESTINATION "${lom_install_licenses}/pcsx-redux")
install(FILES packaging/licenses/xbr.txt DESTINATION "${lom_install_licenses}/xbr")
install(FILES packaging/licenses/lua.txt DESTINATION "${lom_install_licenses}/lua")
install(FILES packaging/licenses/alegreya-OFL.txt DESTINATION "${lom_install_licenses}/alegreya")
install(FILES packaging/licenses/noto-sans-cjk-OFL.txt DESTINATION "${lom_install_licenses}/noto-sans-cjk")
install(FILES packaging/licenses/atkinson-hyperlegible-OFL.txt DESTINATION "${lom_install_licenses}/atkinson-hyperlegible")

if(UNIX AND NOT APPLE AND TARGET lom-launcher)
    install(FILES "packaging/linux/${LOM_APP_ID}.desktop" DESTINATION "${CMAKE_INSTALL_DATADIR}/applications")
    install(FILES "packaging/linux/${LOM_APP_ID}.metainfo.xml" DESTINATION "${CMAKE_INSTALL_DATADIR}/metainfo")
    install(FILES "packaging/linux/${LOM_APP_ID}.png" DESTINATION "${CMAKE_INSTALL_DATADIR}/icons/hicolor/512x512/apps")
endif()
