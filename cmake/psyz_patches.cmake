function(lom_psyz_condition_holds condition result)
    set(holds FALSE)
    if(condition STREQUAL "")
        set(holds TRUE)
    elseif(condition STREQUAL "apple")
        if(APPLE)
            set(holds TRUE)
        endif()
    elseif(condition STREQUAL "sdl")
        if(TARGET SDL3-static)
            set(holds TRUE)
        endif()
    elseif(condition STREQUAL "menu" OR condition STREQUAL "sdl3_gpu")
        if(PSYZ_RENDERER STREQUAL "sdl3_gpu")
            set(holds TRUE)
        endif()
    elseif(condition STREQUAL "sdl3_gl")
        if(PSYZ_RENDERER STREQUAL "sdl3_gl")
            set(holds TRUE)
        endif()
    elseif(condition STREQUAL "hd")
        if(NOT WIN32 OR EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/src/gpu/shaders/lom_psx_frag_dxil.h")
            set(holds TRUE)
        else()
            message(STATUS "No Direct3D 12 build of the drawing shaders yet: building without the Remaster's HD backgrounds")
        endif()
    else()
        message(FATAL_ERROR "patches/psyz/series.json names a condition the build doesn't know: \"${condition}\"")
    endif()
    set(${result} ${holds} PARENT_SCOPE)
endfunction()

function(lom_json_optional json key result)
    string(JSON value ERROR_VARIABLE missing GET "${json}" ${key})
    if(missing)
        set(value "")
    endif()
    set(${result} "${value}" PARENT_SCOPE)
endfunction()

function(lom_json_strings json key result)
    set(values)
    string(JSON count ERROR_VARIABLE missing LENGTH "${json}" ${key})
    if(NOT missing AND count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON value GET "${json}" ${key} ${index})
            list(APPEND values "${value}")
        endforeach()
    endif()
    set(${result} "${values}" PARENT_SCOPE)
endfunction()

function(lom_psyz_patch_paths entry result)
    set(paths)
    string(JSON count LENGTH "${entry}" patches)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON kind TYPE "${entry}" patches ${index})
        if(kind STREQUAL "OBJECT")
            string(JSON name GET "${entry}" patches ${index} patch)
            string(JSON when GET "${entry}" patches ${index} when)
        else()
            string(JSON name GET "${entry}" patches ${index})
            set(when "")
        endif()
        lom_psyz_condition_holds("${when}" wanted)
        if(wanted)
            list(APPEND paths "${CMAKE_CURRENT_SOURCE_DIR}/patches/psyz/${name}")
        endif()
    endforeach()
    set(${result} "${paths}" PARENT_SCOPE)
endfunction()

function(lom_replace_target_source target original replacement)
    get_target_property(sources ${target} SOURCES)
    string(REPLACE "." "[.]" pattern "${original}")
    set(kept ${sources})
    list(FILTER kept EXCLUDE REGEX "(^|/)${pattern}$")
    list(LENGTH sources before)
    list(LENGTH kept after)
    math(EXPR removed "${before} - ${after}")
    if(NOT removed EQUAL 1)
        message(FATAL_ERROR "Expected exactly one ${original} in ${target}'s sources, found ${removed}")
    endif()
    set_property(TARGET ${target} PROPERTY SOURCES "${kept}")
    target_sources(${target} PRIVATE "${replacement}")
endfunction()

function(lom_patch_psyz_source entry)
    lom_json_optional("${entry}" when when)
    lom_psyz_condition_holds("${when}" wanted)
    if(NOT wanted)
        return()
    endif()
    string(JSON source GET "${entry}" source)
    string(JSON output GET "${entry}" output)
    set(output_path "${CMAKE_CURRENT_BINARY_DIR}/generated/${output}")
    lom_psyz_patch_paths("${entry}" patch_paths)
    set(patch_arguments)
    foreach(patch IN LISTS patch_paths)
        list(APPEND patch_arguments --patch "${patch}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${LOM_PSYZ_DIR}/${source}" ${patch_paths})
    get_filename_component(output_folder "${output_path}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_folder}")
    execute_process(COMMAND ${Python3_EXECUTABLE} "${CMAKE_CURRENT_SOURCE_DIR}/tools/build/prepare_native_source.py"
        "${LOM_PSYZ_DIR}" --source "${source}" ${patch_arguments} --output "${output_path}" --git "${GIT_EXECUTABLE}"
        RESULT_VARIABLE prepare_result)
    if(NOT prepare_result EQUAL 0)
        message(FATAL_ERROR "Couldn't patch ${source}. The error is above.")
    endif()
    lom_json_optional("${entry}" target target)
    if(NOT target)
        return()
    endif()
    string(JSON replaces GET "${entry}" replaces)
    lom_replace_target_source(${target} "${replaces}" "${output_path}")
    lom_json_strings("${entry}" include_directories folders)
    if(folders)
        list(TRANSFORM folders PREPEND "${LOM_PSYZ_DIR}/")
        set_source_files_properties("${output_path}" TARGET_DIRECTORY ${target} PROPERTIES INCLUDE_DIRECTORIES "${folders}")
    endif()
    lom_json_strings("${entry}" defines defines)
    if(defines)
        set_property(SOURCE "${output_path}" TARGET_DIRECTORY ${target} APPEND PROPERTY COMPILE_DEFINITIONS ${defines})
    endif()
endfunction()

function(lom_patch_psyz_sources series)
    file(READ "${series}" series_json)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${series}"
        "${CMAKE_CURRENT_SOURCE_DIR}/tools/build/prepare_native_source.py")
    string(JSON count LENGTH "${series_json}" files)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON entry GET "${series_json}" files ${index})
        lom_patch_psyz_source("${entry}")
    endforeach()
endfunction()
